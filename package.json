{
  "name": "cheerpsy",
  "private": true,
  "scripts": {
    "dev:admin": "turbo run dev --filter=admin",
    "dev:booking": "turbo run dev --filter=booking",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "db:studio:admin": "pnpm --filter admin exec prisma studio",
    "db:studio:booking": "pnpm --filter booking exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  }
}
