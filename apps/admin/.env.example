# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/cheerpsy_admin"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3001"

# Internal API secret (shared with booking service)
INTERNAL_API_SECRET="generate-with-openssl-rand-hex-48"

# Booking service URL (optional, defaults to localhost:3000 in dev)
# BOOKING_INTERNAL_URL="http://booking.railway.internal:3000"

# IP allowlist for admin (comma-separated, empty = allow all)
# ADMIN_IP_ALLOWLIST="1.2.3.4,5.6.7.8"
