generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model StaffUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("therapist") // admin | accountant | therapist
  therapistId  String?  @map("therapist_id")
  therapist    Therapist? @relation(fields: [therapistId], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  importLogs   ImportLog[]

  @@map("staff_users")
}

model Therapist {
  id             String   @id @default(cuid())
  name           String   @unique
  commissionRate Float    @default(0.8) @map("commission_rate")
  isActive       Boolean  @default(true) @map("is_active")
  bio            String?
  specialties    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  staffUsers     StaffUser[]
  sessions       Session[]
  availability   TherapistAvailability[]

  @@map("therapists")
}

model TherapistAvailability {
  id             String   @id @default(cuid())
  therapistId    String   @map("therapist_id")
  therapist      Therapist @relation(fields: [therapistId], references: [id])
  dayOfWeek      Int      @map("day_of_week") // 0=Sunday, 6=Saturday
  startTime      String   @map("start_time") // HH:mm
  endTime        String   @map("end_time")   // HH:mm
  isRecurring    Boolean  @default(true) @map("is_recurring")
  effectiveFrom  DateTime? @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("therapist_availability")
}

model Client {
  id                  String   @id @default(cuid())
  name                String
  phone               String?
  email               String?
  bookingClientUserId String?  @map("booking_client_user_id")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  sessions            Session[]

  @@map("clients")
}

model Session {
  id                   String   @id @default(cuid())
  date                 DateTime
  room                 String?
  therapistId          String   @map("therapist_id")
  therapist            Therapist @relation(fields: [therapistId], references: [id])
  clientId             String   @map("client_id")
  client               Client   @relation(fields: [clientId], references: [id])
  source               String   @default("manual") // excel_import | manual | booking
  bookingAppointmentId String?  @map("booking_appointment_id")
  billingType          String?  @map("billing_type")
  amountReceivable     Float?   @map("amount_receivable")
  receivableType       String?  @map("receivable_type")
  location             String?
  paymentStatus        String?  @map("payment_status")
  amountReceived       Float?   @map("amount_received")
  institutionMonth     String?  @map("institution_month")
  counselingFormat     String?  @map("counseling_format")
  counselingType       String?  @map("counseling_type")
  hours                Float?
  hourlyRate           Float?   @map("hourly_rate")
  totalFee             Float?   @map("total_fee")
  commissionRate       Float?   @map("commission_rate")
  therapistIncome      Float?   @map("therapist_income")
  clinicIncome         Float?   @map("clinic_income")
  notes                String?
  therapistPaid        String?  @map("therapist_paid")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model ImportLog {
  id           String   @id @default(cuid())
  filename     String
  rowsImported Int      @map("rows_imported")
  importedBy   String   @map("imported_by")
  importedByUser StaffUser @relation(fields: [importedBy], references: [id])
  importedAt   DateTime @default(now()) @map("imported_at")

  @@map("import_logs")
}
