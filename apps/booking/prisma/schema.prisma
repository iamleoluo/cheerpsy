generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ClientUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")
  lastLogin    DateTime? @map("last_login")

  appointments Appointment[]

  @@map("client_users")
}

model TherapistProfile {
  id                  String   @id @default(cuid())
  name                String
  bio                 String?
  specialties         String?
  photoUrl            String?  @map("photo_url")
  isAcceptingBookings Boolean  @default(true) @map("is_accepting_bookings")
  internalTherapistId String?  @unique @map("internal_therapist_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  availability        TherapistAvailability[]
  appointments        Appointment[]

  @@map("therapist_profiles")
}

model TherapistAvailability {
  id                 String   @id @default(cuid())
  therapistProfileId String   @map("therapist_profile_id")
  therapistProfile   TherapistProfile @relation(fields: [therapistProfileId], references: [id], onDelete: Cascade)
  dayOfWeek          Int      @map("day_of_week")
  startTime          String   @map("start_time")
  endTime            String   @map("end_time")
  isRecurring        Boolean  @default(true) @map("is_recurring")
  effectiveFrom      DateTime? @map("effective_from")
  effectiveUntil     DateTime? @map("effective_until")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("therapist_availability")
}

model Appointment {
  id                 String   @id @default(cuid())
  clientUserId       String   @map("client_user_id")
  clientUser         ClientUser @relation(fields: [clientUserId], references: [id])
  therapistProfileId String?  @map("therapist_profile_id")
  therapistProfile   TherapistProfile? @relation(fields: [therapistProfileId], references: [id])
  requestedDate      DateTime @map("requested_date")
  requestedTimeSlot  String   @map("requested_time_slot")
  preferredFormat    String   @default("in_person") @map("preferred_format") // online | in_person
  clientName         String   @map("client_name")
  clientPhone        String?  @map("client_phone")
  clientEmail        String?  @map("client_email")
  status             String   @default("pending") // pending | confirmed | rejected | cancelled
  rejectionReason    String?  @map("rejection_reason")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("appointments")
}
