# 複製成 .env.production 並填入真實值，這個檔案不會被 git 追蹤（見 .gitignore）
# 產生隨機密鑰： openssl rand -hex 32（Git for Windows 內建的 Git Bash 就有 openssl）

# --- Postgres ---
POSTGRES_DB=cheerpsy
POSTGRES_USER=cheerpsy
POSTGRES_PASSWORD=

# --- API (apps/api/app/config.py) ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ID_ENCRYPTION_KEY=
# 逗號分隔，需包含前端的網域（Stage 1 先填測試網域，Stage 2 換成正式網域）
CORS_ORIGINS=https://win-test.cheerpsies.com

# --- Web ---
# 瀏覽器端呼叫用，build-time 變數，改了要重新 build（docker compose build web）
NEXT_PUBLIC_API_URL=https://win-test-api.cheerpsies.com
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://win-test.cheerpsies.com
